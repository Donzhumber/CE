# ==============================================================================
# .gitignore — Computational Economics Submission & Replication Package
# ==============================================================================

# macOS metadata
.DS_Store
._*
.Spotlight-V100
.Trashes

# LaTeX build & intermediate files
*.aux
*.log
*.out
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg
*.brf
*.idx
*.ilg
*.ind
*.lof
*.lot
*.nav
*.snm
*.toc
*.vrb
missfont.log

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Lean 4 / Lake build artifacts
.lake/build/
.lake/packages/

# Editors & IDE temporary files
.vscode/
.idea/
*.swp
*.swo
*~

# ==============================================================================
# Whitelist Essential Research Assets
# ==============================================================================
!*.pdf
!*.zip
!*.pt
!*.dta
!*.xlsx
!*.csv
!main/*.bbl
